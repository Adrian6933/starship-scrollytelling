---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Starship · Camino a la órbita',
  description = 'Experiencia scrollytelling del lanzamiento de la Starship.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- El primer fotograma como preload: elimina el flash negro inicial -->
    <link rel="preload" as="image" href="/frames/frame-001.webp" />
  </head>
  <body class="relative bg-space font-[Space_Grotesk,sans-serif]">
    <slot />
  </body>
</html>
